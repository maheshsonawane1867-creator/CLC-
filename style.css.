* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background: #f4f7fb;
    color: #1e293b;
}

.container {
    display: flex;
    min-height: 100vh;
}

/* Sidebar */

.sidebar {
    width: 250px;
    background: #111827;
    color: white;
    padding: 25px 18px;
    position: fixed;
    height: 100vh;
    left: 0;
    top: 0;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    margin-bottom: 40px;
    padding-left: 10px;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.sidebar nav a {
    color: #cbd5e1;
    text-decoration: none;
    padding: 14px;
    border-radius: 8px;
    transition: 0.3s;
}

.sidebar nav a:hover,
.sidebar nav a.active {
    background: #2563eb;
    color: white;
}

.sidebar-bottom {
    position: absolute;
    bottom: 30px;
    left: 25px;
    right: 25px;
}

.sidebar-bottom p {
    font-size: 14px;
    margin-bottom: 8px;
}

.sidebar-bottom small {
    color: #94a3b8;
}

.progress {
    width: 100%;
    height: 7px;
    background: #374151;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 7px;
}

.progress-bar {
    width: 65%;
    height: 100%;
    background: #3b82f6;
}

.sidebar-bottom button {
    width: 100%;
    border: none;
    background: #2563eb;
    color: white;
    padding: 10px;
    margin-top: 15px;
    border-radius: 7px;
    cursor: pointer;
}

/* Main */

.main {
    margin-left: 250px;
    width: calc(100% - 250px);
    padding: 30px;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

header h1 {
    font-size: 30px;
}

header p {
    color: #64748b;
    margin-top: 5px;
}

.user {
    display: flex;
    align-items: center;
    gap: 12px;
}

.notification {
    font-size: 20px;
    cursor: pointer;
}

.avatar {
    width: 40px;
    height: 40px;
    background: #2563eb;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-weight: bold;
}

/* Cards */

.card {
    background: white;
    border-radius: 12px;
    padding: 22px;
    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 25px;
}

.stat-card {
    display: flex;
    align-items: center;
    gap: 15px;
    position: relative;
}

.icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
}

.blue {
    background: #dbeafe;
}

.green {
    background: #dcfce7;
}

.orange {
    background: #ffedd5;
}

.purple {
    background: #ede9fe;
}

.stat-card h3 {
    font-size: 23px;
}

.stat-card p {
    color: #64748b;
    font-size: 13px;
    margin-top: 4px;
}

.percentage {
    position: absolute;
    right: 15px;
    top: 15px;
    font-size: 11px;
    color: #16a34a;
}

/* Dashboard Grid */

.dashboard-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 25px;
    margin-bottom: 25px;
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.card-header h2 {
    font-size: 19px;
}

.card-header p {
    color: #64748b;
    font-size: 13px;
    margin-top: 5px;
}

select {
    border: 1px solid #e2e8f0;
    padding: 8px 10px;
    border-radius: 6px;
    color: #475569;
}

/* Storage */

.storage-card {
    text-align: center;
}

.storage-circle {
    width: 170px;
    height: 170px;
    margin: 20px auto;
    border-radius: 50%;
    background: conic-gradient(
        #2563eb 0deg 234deg,
        #e2e8f0 234deg 360deg
    );
    display: flex;
    align-items: center;
    justify-content: center;
}

.circle-inner {
    width: 125px;
    height: 125px;
    background: white;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.circle-inner strong {
    font-size: 30px;
}

.circle-inner span {
    color: #64748b;
    font-size: 13px;
}

.storage-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
}

.storage-info div {
    display: flex;
    align-items: center;
    gap: 8px;
}

.storage-info b {
    margin-left: auto;
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.blue-dot {
    background: #2563eb;
}

.green-dot {
    background: #22c55e;
}

.orange-dot {
    background: #f97316;
}

.gray-dot {
    background: #94a3b8;
}

/* Server */

.servers-card {
    margin-bottom: 25px;
}

.primary-btn {
    background: #2563eb;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 7px;
    cursor: pointer;
}

.primary-btn:hover {
    background: #1d4ed8;
}

.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    text-align: left;
    padding: 15px;
    border-bottom: 1px solid #e5e7eb;
}

th {
    color: #64748b;
    font-size: 13px;
}

td {
    font-size: 14px;
}

.status {
    font-size: 13px;
}

.online {
    color: #16a34a;
}

.warning {
    color: #f59e0b;
}

.view-btn {
    border: 1px solid #2563eb;
    background: white;
    color: #2563eb;
    padding: 6px 12px;
    border-radius: 5px;
    cursor: pointer;
}

/* Files */

.files-card {
    margin-bottom: 25px;
}

.file {
    display: flex;
    align-items: center;
    padding: 14px 5px;
    border-bottom: 1px solid #e5e7eb;
}

.file:last-child {
    border-bottom: none;
}

.file-icon {
    width: 45px;
    height: 45px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: bold;
    margin-right: 15px;
}

.pdf {
    background: #fee2e2;
    color: #dc2626;
}

.doc {
    background: #dbeafe;
    color: #2563eb;
}

.image {
    background: #dcfce7;
    color: #16a34a;
}

.file-details {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.file-details span {
    color: #64748b;
    font-size: 12px;
}

.download-btn {
    margin-left: auto;
    border: none;
    background: #eff6ff;
    color: #2563eb;
    padding: 8px 12px;
    border-radius: 6px;
    cursor: pointer;
}

footer {
    text-align: center;
    color: #94a3b8;
    padding: 10px;
    font-size: 13px;
}

/* Responsive */

@media (max-width: 1100px) {

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {

    .sidebar {
        width: 70px;
        padding: 20px 10px;
    }

    .logo {
        font-size: 0;
        text-align: center;
    }

    .logo:first-letter {
        font-size: 25px;
    }

    .sidebar nav a {
        font-size: 0;
        text-align: center;
    }

    .sidebar nav a:first-letter {
        font-size: 20px;
    }

    .sidebar-bottom {
        display: none;
    }

    .main {
        margin-left: 70px;
        width: calc(100% - 70px);
        padding: 20px;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    header h1 {
        font-size: 23px;
    }

    .user span {
        display: none;
    }
}

@media (max-width: 500px) {

    .main {
        padding: 12px;
    }

    header {
        align-items: flex-start;
    }

    .dashboard-grid {
        gap: 15px;
    }

    .card {
        padding: 15px;
    }

    .file-details strong {
        font-size: 13px;
    }

    .download-btn {
        font-size: 11px;
        padding: 7px;
    }
}
